# Disable directory listing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct folder access
    RewriteCond %{THE_REQUEST} /assets/?(\s|$) [NC]
    RewriteRule ^ / [R=302,L]

    # Allow access to actual files
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
</IfModule>

# Deny access to dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
