# Disable directory listing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct browser access to folder root
    RewriteCond %{THE_REQUEST} /includes/?(\s|$) [NC]
    RewriteRule ^ / [R=302,L]

    # Allow access to actual files (for PHP includes)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
</IfModule>

# Deny access to dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Deny access to config.php directly
<Files "config.php">
    Require all denied
</Files>
